PORT=8787
DOMAIN=wallet.82-165-176-79.sslip.io
PUBLIC_BASE_URL=https://wallet.82-165-176-79.sslip.io
WEB_CALLBACK_URL=https://wallet.82-165-176-79.sslip.io/callback.html
JOB_TTL_SECONDS=120
ALLOW_WEB_DEMO=true
EXECUTOR_MODE=mock
HELPER_INSTALL_URL=
# Installazione OTA senza PC: URL HTTPS di un'IPA gia firmata ad hoc/enterprise.
# Se valorizzato, il server genera manifest e link itms-services automaticamente.
SKINBRIDGE_IPA_URL=
# Percorso gratuito: IPA non firmata, firmata localmente da SideStore sull'iPhone.
SKINBRIDGE_SIDELOAD_IPA_URL=
SIDESTORE_SETUP_URL=https://sideinstaller.net/
SKINBRIDGE_BUNDLE_ID=com.walletskins.skinbridge
SKINBRIDGE_VERSION=0.1.0
SKINBRIDGE_TITLE=SkinBridge
SUPPORT_URL=
# Esperimento zero-app: viene abilitato dallo script VPS solo dopo aver
# configurato IKEv2, certificato e discovery privata.
SERVER_BRIDGE_ENABLED=false
SERVER_BRIDGE_BINARY=/app/bin/airlift-gateway
SERVER_BRIDGE_STATE_DIR=/var/lib/wallet-skins-bridge
SERVER_BRIDGE_BIND=0.0.0.0
SERVER_BRIDGE_PAIR_PORT=49153
SERVER_BRIDGE_DOMAIN=wallet.internal
SERVER_BRIDGE_ADDRESS=10.66.0.1
SERVER_BRIDGE_DNS_BIND=10.66.0.1
SERVER_BRIDGE_DNS_PORT=53
SERVER_BRIDGE_DNS_UPSTREAM=1.1.1.1
SERVER_BRIDGE_DEVICE_ENDPOINT=10.66.0.2:49152
# VPN_REMOTE_ADDRESS, VPN_REMOTE_IDENTIFIER, VPN_USERNAME, VPN_PASSWORD e
# VPN_CA_CERT_BASE64 vengono creati sul VPS e non vanno committati.
# Generate an Ed25519 private key for every non-local deployment.
# JOB_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY----- ...
